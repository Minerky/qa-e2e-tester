{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/triage.schema.json",
  "title": "Triage",
  "type": "object",
  "required": ["schemaVersion", "project", "generatedAt", "findings"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "project": { "type": "string" },
    "environment": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "title", "discipline", "severity", "status", "impact", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^(F|N|P|S)-\\d{3}$" },
        "title": { "type": "string" },
        "discipline": { "enum": ["functional", "network", "performance", "security"] },
        "severity": { "enum": ["P1", "P2", "P3", "info"] },
        "status": { "enum": ["open", "confirmed", "fixed", "retest-pass", "false-positive", "accepted-risk", "wont-fix"] },
        "cvss": {
          "type": "object",
          "properties": {
            "version": { "enum": ["3.1", "4.0"] },
            "vector": { "type": "string" },
            "score": { "type": "number", "minimum": 0, "maximum": 10 }
          }
        },
        "cwe": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } },
        "impact": { "type": "string" },
        "recommendation": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "minItems": 1 },
        "chain": { "type": "array", "items": { "type": "string" } },
        "owner": { "type": "string" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "redacted": { "type": "boolean", "default": true }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["path", "type"],
      "properties": {
        "path": { "type": "string" },
        "type": { "enum": ["screenshot", "log", "har", "json", "trace", "video", "curl"] },
        "caption": { "type": "string" },
        "sha256": { "type": "string" },
        "redacted": { "type": "boolean", "default": true }
      }
    }
  }
}
